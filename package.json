{
  "name": "flight-delay-project",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev --workspace=@flight-delay/server\" \"npm:dev --workspace=@flight-delay/web\"",
    "lint": "eslint server shared web/src web/vite.config.ts",
    "typecheck": "npm run typecheck --workspace=@flight-delay/server && npm run typecheck --workspace=@flight-delay/shared && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "build:web": "npm run build --workspace=@flight-delay/web",
    "format": "prettier --write server shared vitest.config.ts eslint.config.js",
    "format:check": "prettier --check server shared vitest.config.ts eslint.config.js",
    "ingest": "npm run ingest --workspace=@flight-delay/server --",
    "resolve:airport-ids": "npm run resolve:airport-ids --workspace=@flight-delay/server --",
    "build:indexes": "npm run build:indexes --workspace=@flight-delay/server --",
    "explain:report": "npm run explain:report --workspace=@flight-delay/server --",
    "build:stats": "npm run build:stats --workspace=@flight-delay/server --",
    "build:lookup": "npm run build:lookup --workspace=@flight-delay/server --",
    "export:training": "npm run export:training --workspace=@flight-delay/server --",
    "ml:register": "npm run ml:register --workspace=@flight-delay/server --",
    "kafka:init": "npm run kafka:init --workspace=@flight-delay/server --",
    "stream:replay": "npm run stream:replay --workspace=@flight-delay/server --",
    "stream:consume": "npm run stream:consume --workspace=@flight-delay/server --",
    "stream:smoke": "npm run stream:smoke --workspace=@flight-delay/server --",
    "stream:score-missing": "npm run stream:score-missing --workspace=@flight-delay/server --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}

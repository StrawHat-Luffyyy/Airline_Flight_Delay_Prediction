{
  "name": "flight-delay-project",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev --workspace=@flight-delay/server\" \"npm:dev --workspace=@flight-delay/web\"",
    "lint": "eslint server shared",
    "typecheck": "npm run typecheck --workspace=@flight-delay/server && npm run typecheck --workspace=@flight-delay/shared && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "build:web": "npm run build --workspace=@flight-delay/web",
    "format": "prettier --write server shared vitest.config.ts eslint.config.js",
    "format:check": "prettier --check server shared vitest.config.ts eslint.config.js",
    "ingest": "npm run ingest --workspace=@flight-delay/server --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}

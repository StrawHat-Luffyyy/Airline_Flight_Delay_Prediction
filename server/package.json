{
  "name": "@flight-delay/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild server=src/server.ts probe-worker=src/stream/status/probe-worker.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outdir=dist",
    "start": "node --enable-source-maps dist/server.js",
    "start:dev": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ingest": "tsx src/ingest/cli.ts",
    "resolve:airport-ids": "tsx src/ingest/resolve-cli.ts",
    "build:indexes": "tsx src/db/indexes-cli.ts",
    "explain:report": "tsx src/db/explain-cli.ts",
    "build:stats": "tsx src/stats/build-cli.ts",
    "build:lookup": "tsx src/features/lookup-cli.ts",
    "export:training": "tsx src/features/export-cli.ts",
    "ml:register": "tsx src/ml/register-cli.ts",
    "kafka:init": "tsx src/stream/kafka-init-cli.ts",
    "stream:replay": "tsx src/stream/replay-cli.ts",
    "stream:consume": "tsx src/stream/consume-cli.ts",
    "stream:smoke": "tsx src/stream/smoke-cli.ts",
    "stream:score-missing": "tsx src/stream/score-missing-cli.ts",
    "stream:indexes": "tsx src/stream/indexes-cli.ts",
    "stream:verify-status": "tsx src/stream/verify-status-cli.ts",
    "stream:measure": "tsx src/stream/measure-cli.ts",
    "stream:watch": "tsx src/stream/watch-cli.ts",
    "stream:reset": "tsx src/stream/reset-cli.ts",
    "stream:commit-check": "tsx src/stream/commit-check-cli.ts"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.0",
    "helmet": "^8.1.0",
    "mongodb": "^6.20.0",
    "onnxruntime-node": "1.30.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "0.28.2",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}

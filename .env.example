MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=flight_delay
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Interface the API binds to (loopback = this machine only; use 0.0.0.0 to expose it on the LAN)
HOST=127.0.0.1
# POST /api/predict requests allowed per client IP per minute
PREDICT_RATE_LIMIT_PER_MIN=30

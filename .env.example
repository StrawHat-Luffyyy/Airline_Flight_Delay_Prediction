MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=flight_delay
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Interface the API binds to (loopback = this machine only; use 0.0.0.0 to expose it on the LAN)
HOST=127.0.0.1
# POST /api/predict requests allowed per client IP per minute
PREDICT_RATE_LIMIT_PER_MIN=30
# Phase 8 speed layer (Kafka). All optional; the API runs without Kafka.
# Use 127.0.0.1, not localhost: on Windows localhost resolves to ::1 first (see docker-compose.yml).
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=flight-delay
KAFKA_CONSUMER_GROUP=flight-stream
KAFKA_TOPIC_RAW=flights.raw
KAFKA_TOPIC_DLQ=flights.dlq
# GET /api/stream/status rolling window: newest N judged flights in replay order (100-20000)
STREAM_WINDOW_SIZE=2000
# Consumer group session timeout in ms (6000-1800000). 10 s lets the consumer rejoin about 20 s sooner after a broker restart
KAFKA_SESSION_TIMEOUT_MS=10000

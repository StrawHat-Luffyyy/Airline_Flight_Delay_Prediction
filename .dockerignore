# The production images (deploy/Dockerfile) need sources, lockfile and ml/artifacts only.
# Secrets, data and local state never enter the build context.
.git
**/node_modules
**/dist
data
.env
.env.*
!.env.example
atlas-credentials.env
deploy/secrets
ml/.venv
**/__pycache__
coverage
*.log
.claude
.playwright-mcp
docs
# resolve:airport-ids (run from the tools image) reads this mapping.
!docs/airport-id-map.json
web/.impeccable
